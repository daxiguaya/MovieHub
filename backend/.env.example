# Copy to .env for local development; never commit real secrets.
MOVIEHUB_DATA_DIR=/data
MOVIEHUB_IMPORT_DIR=/imports
MOVIEHUB_API_KEY=
# TMDB read access token; server-side only, never expose to frontend.
TMDB_API_READ_TOKEN=
MOVIEHUB_CORS_ORIGINS=[]
MOVIEHUB_LOG_LEVEL=INFO

MOVIEHUB_RATE_LIMIT_SEARCH=120/minute
MOVIEHUB_RATE_LIMIT_GENRES=60/minute
MOVIEHUB_RATE_LIMIT_REGIONS=60/minute
MOVIEHUB_RATE_LIMIT_STATS=60/minute
MOVIEHUB_RATE_LIMIT_POSTER=60/minute
MOVIEHUB_RATE_LIMIT_IMPORT=5/minute
