# Copy to the project root as .env and edit before running Compose.
# The data directory must be writable by MOVIEHUB_UID:MOVIEHUB_GID.
MOVIEHUB_DATA_PATH=/volume1/docker/moviehub/data
MOVIEHUB_BACKUP_PATH=/volume1/docker/moviehub/backup
# Optional: set only when using the Scout read-only import adapter.
# If omitted, Compose mounts ./deploy/empty-imports as an empty read-only directory.
# MOVIEHUB_IMPORT_PATH=/absolute/path/to/the/read-only-scout-import-directory
MOVIEHUB_UID=10001
MOVIEHUB_GID=10001

# Mount the whole updater config directory to avoid stale single-file bind mounts.
MOVIEHUB_IMDB_CONFIG_DIR=/volume1/docker/moviehub/config
# Optional: override the default /data/db/imdb-ratings.sqlite3 index location.
# IMDB_RATINGS_INDEX_PATH=/absolute/path/to/imdb-ratings.sqlite3

# Generate a long random value. Keep this file private and out of Git.
MOVIEHUB_API_KEY=replace-with-a-long-random-secret

# Optional Xiaoya search URL template; {query} is URL-encoded by the frontend.
MOVIEHUB_XIAOYA_SEARCH_URL_TEMPLATE=http://zwnas.notedream.com:5678/search?box={query}&type=video&url=

# Same-origin NPM access normally needs no CORS origins.
MOVIEHUB_CORS_ORIGINS=[]
MOVIEHUB_LOG_LEVEL=INFO

# Optional: set to the exact MovieHub frontend container IP (the direct peer
# forwarding /api requests to the backend), or its dedicated Docker subnet.
# Do not use the NPM IP unless NPM itself connects directly to the backend.
# Do not use "*". Default trusts loopback only.
MOVIEHUB_TRUSTED_PROXY_IPS=127.0.0.1
