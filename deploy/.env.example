# Copy to the project root as .env and edit before running Compose.
# The data directory must be writable by MOVIEHUB_UID:MOVIEHUB_GID.
MOVIEHUB_DATA_PATH=/volume1/docker/moviehub/data
MOVIEHUB_BACKUP_PATH=/volume1/docker/moviehub/backup
# Optional: set only when using the Scout read-only import adapter.
# If omitted, Compose mounts ./deploy/empty-imports as an empty read-only directory.
# MOVIEHUB_IMPORT_PATH=/absolute/path/to/the/read-only-scout-import-directory
MOVIEHUB_FRONTEND_CONFIG_PATH=./deploy/frontend-config.json
MOVIEHUB_UID=10001
MOVIEHUB_GID=10001

# Generate a long random value. Keep this file private and out of Git.
MOVIEHUB_API_KEY=replace-with-a-long-random-secret

# Same-origin NPM access normally needs no CORS origins.
MOVIEHUB_CORS_ORIGINS=[]
MOVIEHUB_LOG_LEVEL=INFO

# Optional: set to the exact NPM container IP or its dedicated Docker subnet
# after inspecting the network. Do not use "*". Default trusts loopback only.
MOVIEHUB_TRUSTED_PROXY_IPS=127.0.0.1
